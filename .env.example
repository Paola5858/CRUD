# MOTOSENSE - Template de Configurações de Ambiente
# ⚠️  COPIE ESTE ARQUIVO PARA .env E CONFIGURE OS VALORES REAIS
# ⚠️  NUNCA COMMITAR ARQUIVOS .env COM DADOS REAIS!

# Ambiente (development/production)
DJANGO_ENV=development

# Segurança - GERAR NOVA SECRET_KEY PARA PRODUÇÃO!
# Use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Debug - SEMPRE False em produção!
DEBUG=True

# Banco de Dados - Configurar para produção
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=3306

# Hosts permitidos - Configurar domínios reais em produção
ALLOWED_HOSTS=localhost,127.0.0.1

# Configurações de Email (opcional)
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@domain.com
# EMAIL_HOST_PASSWORD=your-email-password

# Configurações de Cache (opcional)
# REDIS_URL=redis://localhost:6379/0

# Configurações de Storage (opcional)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name